<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- Top Dark Control Bar -->
    <LinearLayout
        android:id="@+id/top_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#121212"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings"
            app:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Flash Button -->
        <ImageButton
            android:id="@+id/btn_flash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/flash"
            android:src="@drawable/ic_flash_off"
            app:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- HDR Indicator Badge -->
        <TextView
            android:id="@+id/btn_hdr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="HDR"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Grid Toggle -->
        <ImageButton
            android:id="@+id/btn_grid"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/grid"
            android:src="@drawable/ic_grid"
            app:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Filter / Lens Button -->
        <ImageButton
            android:id="@+id/btn_filter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/filters"
            android:src="@drawable/ic_filter"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- Camera Preview Center Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_controls_container"
        android:layout_below="@id/top_toolbar">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 3x3 Grid Overlay -->
        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:contentDescription="Grid Overlay"
            android:focusable="false"
            android:scaleType="fitXY"
            android:src="@drawable/bg_grid_overlay"
            android:visibility="gone" />

        <!-- Pro Panel Toggle Button -->
        <TextView
            android:id="@+id/btn_pro_toggle"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:layout_alignParentTop="true"
            android:layout_margin="12dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="PRO"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <!-- Pro Camera Sliders Panel -->
        <LinearLayout
            android:id="@+id/panel_pro_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_pill"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="Zoom"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_zoom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:value="1.0"
                    android:valueFrom="1.0"
                    android:valueTo="5.0" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="Exposure"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_exposure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="1.0"
                    android:value="-2"
                    android:valueFrom="-4"
                    android:valueTo="4" />
            </LinearLayout>

        </LinearLayout>

        <!-- Countdown Overlay -->
        <TextView
            android:id="@+id/tv_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="serif"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="#FFFFFF"
            android:textSize="96sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Recording Indicator -->
        <LinearLayout
            android:id="@+id/recording_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_shutter_inner"
                app:tint="@color/shutter_red" />

            <TextView
                android:id="@+id/tv_recording_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:text="@string/zero_time"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </RelativeLayout>

    <!-- Bottom Dark Controls Container -->
    <LinearLayout
        android:id="@+id/bottom_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#121212"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Mode Carousel Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tab_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="Video"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="Photo"
                    android:textColor="#1D4542"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="Strip"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Timer Indicator Button inside bar -->
                <LinearLayout
                    android:id="@+id/btn_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tv_timer_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Timer: Off"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Shutter & Actions Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:paddingHorizontal="32dp">

            <!-- Left: Rounded Gallery Thumbnail Shortcut -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_gallery"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="#2A2A2A"
                app:cardCornerRadius="12dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="1dp">

                <ImageButton
                    android:id="@+id/btn_gallery"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/gallery"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_gallery"
                    app:tint="#FFFFFF" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Center: Outer Ring Shutter Button -->
            <RelativeLayout
                android:id="@+id/btn_shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_shutter_outer">

                <View
                    android:id="@+id/shutter_inner"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_shutter_inner" />
            </RelativeLayout>

            <!-- Right: Flip Camera Button -->
            <ImageButton
                android:id="@+id/btn_flip_camera"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/flip_camera"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_camera_flip"
                app:tint="#FFFFFF" />

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>