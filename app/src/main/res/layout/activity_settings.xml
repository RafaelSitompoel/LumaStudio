<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    tools:context=".SettingsActivity">

    <!-- Top Header -->
    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/btn_back"
            android:fontFamily="sans-serif-medium"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_bar"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp">

            <!-- SECTION: CAMERA & SHOOTING -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="CAMERA &amp; SHOOTING"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#161F2B"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_shutter_sound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Suara Shutter Kamera"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:thumbTint="#FFFFFF"
                        app:trackTint="#00E676" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#222D3D" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_vibration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Getaran Haptik"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:thumbTint="#FFFFFF"
                        app:trackTint="#00E676" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#222D3D" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kamera Grid 3x3"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:thumbTint="#FFFFFF"
                        app:trackTint="#00E676" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#222D3D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kamera Awal (Default Lens):"
                        android:textColor="#8A99AD"
                        android:textSize="13sp" />

                    <RadioGroup
                        android:id="@+id/rg_lens"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_lens_front"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:text="Depan"
                            android:textColor="#FFFFFF" />

                        <RadioButton
                            android:id="@+id/rb_lens_back"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Belakang"
                            android:textColor="#FFFFFF" />
                    </RadioGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: APPEARANCE & THEME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="APPEARANCE &amp; THEME"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#161F2B"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode Tampilan:"
                        android:textColor="#8A99AD"
                        android:textSize="13sp" />

                    <RadioGroup
                        android:id="@+id/rg_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <RadioButton
                            android:id="@+id/rb_theme_system"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ikuti Sistem"
                            android:textColor="#FFFFFF" />

                        <RadioButton
                            android:id="@+id/rb_theme_light"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mode Terang (Light)"
                            android:textColor="#FFFFFF" />

                        <RadioButton
                            android:id="@+id/rb_theme_dark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mode Gelap (Dark)"
                            android:textColor="#FFFFFF" />
                    </RadioGroup>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#222D3D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Warna Aksen Aplikasi:"
                        android:textColor="#8A99AD"
                        android:textSize="13sp" />

                    <RadioGroup
                        android:id="@+id/rg_accent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <RadioButton
                            android:id="@+id/rb_accent_teal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Midnight Teal (Default)"
                            android:textColor="#FFFFFF" />

                        <RadioButton
                            android:id="@+id/rb_accent_sage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sage Green"
                            android:textColor="#FFFFFF" />

                        <RadioButton
                            android:id="@+id/rb_accent_mocha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Vintage Mocha"
                            android:textColor="#FFFFFF" />
                    </RadioGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: PERFORMANCE & ANIMATION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="PERFORMANCE &amp; ANIMATION"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#161F2B"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_animation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Animasi Antarmuka (Animations)"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:thumbTint="#FFFFFF"
                        app:trackTint="#00E676" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#222D3D" />

                    <RadioGroup
                        android:id="@+id/rg_fps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            android:id="@+id/rb_30fps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="30 FPS — Hemat Baterai"
                            android:textColor="#FFFFFF" />

                        <RadioButton
                            android:id="@+id/rb_60fps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="60 FPS — Pengalaman Mulus"
                            android:textColor="#FFFFFF" />
                    </RadioGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: EXPORT & STORAGE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="EXPORT &amp; STORAGE"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#161F2B"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kualitas Ekspor Gambar:"
                        android:textColor="#8A99AD"
                        android:textSize="13sp" />

                    <RadioGroup
                        android:id="@+id/rg_export_quality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <RadioButton
                            android:id="@+id/rb_export_standard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Standard Quality (80%)"
                            android:textColor="#FFFFFF" />

                        <RadioButton
                            android:id="@+id/rb_export_high"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="High Quality (90% - Rekomendasi)"
                            android:textColor="#FFFFFF" />

                        <RadioButton
                            android:id="@+id/rb_export_max"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Maximum Available (100%)"
                            android:textColor="#FFFFFF" />
                    </RadioGroup>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#222D3D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Format Gambar:"
                        android:textColor="#8A99AD"
                        android:textSize="13sp" />

                    <RadioGroup
                        android:id="@+id/rg_image_format"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_format_jpeg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:text="JPEG"
                            android:textColor="#FFFFFF" />

                        <RadioButton
                            android:id="@+id/rb_format_png"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PNG (Lossless)"
                            android:textColor="#FFFFFF" />
                    </RadioGroup>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#222D3D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lokasi Penyimpanan:"
                        android:textColor="#8A99AD"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_storage_path"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/internal_storage"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_select_saf"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/select_saf_folder"
                        android:textColor="#00E676"
                        app:strokeColor="#00E676" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- App Version & Reset -->
            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:text="@string/app_version"
                android:textColor="#8A99AD"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_reset"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="@string/reset_settings"
                android:textColor="@color/shutter_red" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>